# Copy to .env and fill in what you want to override.
# Every value here is a default or an example. Never put a real credential in this file.

# Directory for hourly tapes and manifests.
# Default: data
RIPTIDE_OUTPUT_DIR=

# Comma-separated symbols, collected on both spot and perp.
# Default: btcusdt,ethusdt,solusdt,xrpusdt,bnbusdt,dogeusdt,adausdt,avaxusdt,linkusdt,ltcusdt
RIPTIDE_SYMBOLS=
